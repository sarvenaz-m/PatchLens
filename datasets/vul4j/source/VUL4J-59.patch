From b86beca8feb26f9a3181e87fe36382f8ab4bdb98 Mon Sep 17 00:00:00 2001
From: tomjohan <tommy.johansen@finn.no>
Date: Wed, 27 May 2015 09:24:51 +0200
Subject: [PATCH] Keep tag that have not been closed by > before reaching EOF.

---
 src/main/java/org/jsoup/parser/TokeniserState.java     | 1 +
 src/test/java/org/jsoup/parser/XmlTreeBuilderTest.java | 7 +++++++
 2 files changed, 8 insertions(+)

diff --git a/src/main/java/org/jsoup/parser/TokeniserState.java b/src/main/java/org/jsoup/parser/TokeniserState.java
index ee2bc448a4..4168c8ae98 100644
--- a/src/main/java/org/jsoup/parser/TokeniserState.java
+++ b/src/main/java/org/jsoup/parser/TokeniserState.java
@@ -757,6 +757,7 @@ void read(Tokeniser t, CharacterReader r) {
                     break;
                 case eof:
                     t.eofError(this);
+                    t.emitTagPending();
                     t.transition(Data);
                     break;
                 case '>':
diff --git a/src/test/java/org/jsoup/parser/XmlTreeBuilderTest.java b/src/test/java/org/jsoup/parser/XmlTreeBuilderTest.java
index 275307fa12..71e3b22754 100644
--- a/src/test/java/org/jsoup/parser/XmlTreeBuilderTest.java
+++ b/src/test/java/org/jsoup/parser/XmlTreeBuilderTest.java
@@ -121,4 +121,11 @@ public void testDoesNotForceSelfClosingKnownTags() {
         Document doc = Jsoup.parse("x", "", Parser.xmlParser());
         assertEquals(Syntax.xml, doc.outputSettings().syntax());
     }
+
+    @Test
+    public void testDoesHandleEOFInTag() {
+        String html = "<img src=asdf onerror=\"alert(1)\" x=";
+        Document xmlDoc = Jsoup.parse(html, "", Parser.xmlParser());
+        assertEquals("<img src=\"asdf\" onerror=\"alert(1)\" x=\"\" />", xmlDoc.html());
+    }
 }
